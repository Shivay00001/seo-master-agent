# AI SEO Master Agent — environment configuration
# Copy to .env and fill in real values. Never commit a real .env.
#
# Generate a strong API key with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# REQUIRED — shared-secret API key. All /api/* endpoints demand it via the
# X-API-Key header. Without it the server refuses to boot.
SEO_API_KEY=dummy-change-me-generate-a-random-secret

# LLM provider keys (dummy placeholders — set real keys only in production,
# or send them per-request via X-OpenAI-Key / X-Anthropic-Key / X-Gemini-Key /
# X-GLM-Key headers; per-request keys are used in-memory and never persisted)
OPENAI_API_KEY=dummy
ANTHROPIC_API_KEY=dummy
GEMINI_API_KEY=dummy
ZHIPUAI_API_KEY=dummy

# Self-hosted Ollama base URL (used when model_id starts with "ollama")
OLLAMA_BASE_URL=http://localhost:11434

# Database (SQLite default; for Postgres use
# postgresql+asyncpg://user:password@host:5432/seo — requires asyncpg package)
DATABASE_URL=sqlite+aiosqlite:///./seo.db

# Comma-separated allowed origins for the browser UI (empty = no CORS, safest
# for server-to-server use). Never use "*" with credentials enabled.
CORS_ORIGINS=

# HTTP timeout (seconds) when fetching a client's website for on-page/content tasks
HTTP_TIMEOUT_SECONDS=15
# Max characters of fetched HTML sent to the LLM
MAX_HTML_CHARS=10000

# Port for local dev (uvicorn --port)
PORT=8000
